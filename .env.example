# 로컬 개발과 운영 배포가 함께 쓰는 예시 파일이다. 실제 값은 .env 에 넣고 커밋하지 않는다.
#
# 운영에서 반드시 채워야 하는 것은 아래 "운영 필수" 항목이다. 비어 있으면 컨테이너가
# 기동 전에 멈춘다. 앱 로그를 뒤지지 않고 원인을 바로 알 수 있게 그렇게 두었다.

# --- 운영 필수 -------------------------------------------------------------

# 인증서를 받을 도메인. 이 서버를 가리키는 A 레코드가 먼저 있어야 한다.
APP_DOMAIN=api.example.com
# Let's Encrypt 만료 알림을 받을 주소.
ACME_EMAIL=ops@example.com

# 프런트엔드(PWA)를 서빙할 도메인. 이 도메인의 A 레코드도 이 서버를 가리켜야 한다.
# Caddyfile 의 정적 서빙 블록이 읽으므로 비워 두면 프록시가 기동하지 못한다.
FRONT_DOMAIN=app.example.com

DB_PASSWORD=change-me

# 32바이트 마스터 키를 Base64로 인코딩한 값. 각각 목적별 하위 키를 분리 파생한다.
#   openssl rand -base64 32
# 비어 있으면 기록 조회와 Push 알림 빈이 생성자에서 막혀 기동에 실패한다.
# 값을 바꾸면 기존에 저장된 원문과 구독 정보를 더 이상 풀 수 없다.
RECORD_DATA_ENCRYPTION_KEY=
PUSH_DATA_ENCRYPTION_KEY=

# 브라우저에서 API 를 부르는 프런트엔드 출처. 쉼표로 여러 개를 줄 수 있다.
FRONTEND_ALLOWED_ORIGINS=https://app.example.com

# API 문서 경로(/swagger-ui*, /v3/api-docs*)에 걸리는 Basic 인증 자격이다.
# 문서를 켜지 않아도 Caddyfile 이 이 값을 읽으므로 비워 두면 프록시가 기동하지 못한다.
#
# 해시 만들기
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '비밀번호'
#
# 결과의 $ 를 모두 $$ 로 바꿔 넣는다. Compose 가 $ 를 변수 시작으로 읽어 값이 깨지기 때문이다.
# 아래처럼 한 번에 넣으면 실수를 줄일 수 있다.
#   HASH=$(docker run --rm caddy:2-alpine caddy hash-password --plaintext '비밀번호')
#   printf 'DOCS_BASIC_AUTH_HASH=%s\n' "$(printf '%s' "$HASH" | sed 's/\$/$$/g')" >> .env
DOCS_BASIC_AUTH_USER=docs
DOCS_BASIC_AUTH_HASH=

# --- 선택 -----------------------------------------------------------------

# 서버에서 Swagger UI 와 /v3/api-docs 를 열지 여부. 기본은 닫힘이다.
# 켜도 위 Basic 인증을 통과해야 닿는다. 저장소의 docs/openapi.generated.json 으로 충분하면
# 켜지 않는 편이 낫다.
API_DOCS_ENABLED=false

# 프런트엔드 빌드 결과(dist/ 내용물)를 올려 둔 서버의 디렉토리. 프록시가 읽기 전용으로
# 마운트한다. 기본값으로 충분하면 넣지 않아도 된다.
FRONT_DIST_DIR=/var/www/flourishing

# 프런트엔드가 API 와 다른 등록 도메인에 있으면 Lax 쿠키는 fetch 에 실리지 않는다.
# 그 배포에서는 None 으로 올린다. 브라우저가 Secure 를 함께 요구하는데 HTTPS 라 충족된다.
SESSION_COOKIE_SAME_SITE=Lax

# Web Push VAPID 키쌍(P-256). 공개키는 프런트엔드에도 그대로 전달한다.
# 비어 있으면 앱은 뜨고 17:30 발송 작업만 건너뛴다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.invalid

# 비어 있으면 관리 설명이 승인된 규칙 문구로 대체되고 결과는 계속 나간다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- 로컬 개발 ------------------------------------------------------------

DB_USERNAME=root
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/flourishing?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
REDIS_HOST=redis
REDIS_PORT=6379
